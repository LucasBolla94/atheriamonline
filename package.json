{
  "name": "atheriam",
  "version": "0.0.0",
  "private": true,
  "description": "Atheriam \u2014 a browser multiplayer social world set in an original contemporary social city.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "tsc --build --force && pnpm --filter @atheriam/client typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @atheriam/db migrate",
    "db:seed": "pnpm --filter @atheriam/api seed",
    "pretest:e2e": "tsx e2e/prepare-database.ts",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "drizzle-orm": "^0.38.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.5",
    "prettier": "^3.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
