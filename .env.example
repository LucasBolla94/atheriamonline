# Copy this file to .env and fill in real values.
# NEVER commit the .env file. It is ignored by git on purpose.

# --- Database (PostgreSQL) ---
POSTGRES_USER=atheriam
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=atheriam
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://atheriam:change-me-locally@localhost:5432/atheriam

# --- Cache and sessions (Redis) ---
REDIS_URL=redis://localhost:6379

# --- HTTP API server (Fastify) ---
API_HOST=0.0.0.0
API_PORT=3001
# Where the browser is served from, used for CORS and cookies.
PUBLIC_ORIGIN=http://localhost:5173

# --- World server (WebSocket) ---
WORLD_HOST=0.0.0.0
WORLD_PORT=3002

# --- Secrets ---
# A long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Sending email (only used for "I have forgotten my password") ---
# Leave these empty and the game still runs: the reset route then says plainly
# that reset is not set up, instead of pretending to send anything.
# For IONOS, the host depends on where the mailbox lives — smtp.ionos.co.uk for
# a UK/EU account, smtp.ionos.com otherwise. Port 465 is TLS from the first
# byte; 587 starts plain and upgrades.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# NEVER put a real password in this file. The real one lives only in
# /etc/atheriam/atheriam.env on the server, readable by root and the service.
SMTP_PASSWORD=
MAIL_FROM=

# Write email to this file instead of sending it. For development and for the
# browser tests. Refused in production, because an outbox nobody reads is a
# password reset that never arrives.
MAIL_OUTBOX=

# --- Rate limits (requests per minute, per IP address) ---
# Ordinary routes. Keep this generous: a home router, an office or a mobile
# network puts many real players behind one address.
GENERAL_RATE_LIMIT_PER_MINUTE=300
# Logging in and registering. This is where passwords get guessed, so it is
# deliberately much lower.
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Environment ---
NODE_ENV=development
LOG_LEVEL=info

# --- Creating the first moderator (only used by `pnpm db:seed`) ---
# Leave these empty and the seed does nothing. Never commit real values.
SEED_MODERATOR_EMAIL=
SEED_MODERATOR_PASSWORD=
SEED_MODERATOR_NAME=
SEED_MODERATOR_DOB=
