# Copy this file to .env and fill in real values.
# NEVER commit the .env file. It is ignored by git on purpose.

# --- Database (PostgreSQL) ---
POSTGRES_USER=atheriam
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=atheriam
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://atheriam:change-me-locally@localhost:5432/atheriam

# --- Cache and sessions (Redis) ---
REDIS_URL=redis://localhost:6379

# --- HTTP API server (Fastify) ---
API_HOST=0.0.0.0
API_PORT=3001
# Where the browser is served from, used for CORS and cookies.
PUBLIC_ORIGIN=http://localhost:5173

# --- World server (WebSocket) ---
WORLD_HOST=0.0.0.0
WORLD_PORT=3002

# --- Secrets ---
# A long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Environment ---
NODE_ENV=development
LOG_LEVEL=info
