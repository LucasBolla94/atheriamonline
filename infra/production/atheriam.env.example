# Production settings for Atheriam.
#
# The real copy of this file lives at /etc/atheriam/atheriam.env on the server,
# is readable only by root and the service user, and is NEVER committed. This
# example exists so that somebody setting up a second machine knows what is
# needed.
#
# `scripts/deploy.sh` creates the real file on first run and generates the
# secrets itself, so normally nobody has to write one by hand.

NODE_ENV=production
LOG_LEVEL=info

# --- Database and cache -------------------------------------------------
# Both run on this machine and listen on 127.0.0.1 only.
DATABASE_URL=postgres://atheriam:CHANGE-ME@127.0.0.1:5432/atheriam_live
# Redis database 1. Number 0 is the development one, 14 belongs to the
# browser tests: production must not share either.
REDIS_URL=redis://127.0.0.1:6379/1

# --- The two servers ----------------------------------------------------
# Both listen on the loopback only. Caddy is the only thing the internet can
# reach, and it forwards to these.
API_HOST=127.0.0.1
API_PORT=3001
WORLD_HOST=127.0.0.1
WORLD_PORT=3002

# Where the browser is served from. Used for CORS and for `Secure` cookies.
PUBLIC_ORIGIN=https://atheriam.online

# --- Secrets ------------------------------------------------------------
# A long random string: openssl rand -hex 32
SESSION_SECRET=CHANGE-ME

# --- Rate limits (requests per minute, per IP address) ------------------
GENERAL_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
